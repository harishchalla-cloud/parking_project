# Example Environment Variables for Parking Management Application
# Copy to .env and set your real values. DO NOT COMMIT .env to source control!

# Django settings
DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.yourdomain.com,localhost,127.0.0.1

# Database (RDS)
AWS_RDS_NAME=yourdbname
AWS_RDS_USER=yourdbuser
AWS_RDS_PASSWORD=yourdbpassword
AWS_RDS_HOST=yourdbendpoint.rds.amazonaws.com
AWS_RDS_PORT=3306

# AWS credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket
AWS_REGION=us-east-1

# Email/SNS
AWS_SNS_TOPIC_ARN=your-sns-topic-arn
EMAIL_HOST=smtp.your-email.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email-user
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# SQS (for QR code generation)
AWS_SQS_QUEUE_URL=your-sqs-url

# CloudWatch
AWS_CLOUDWATCH_LOG_GROUP=your-cloudwatch-group

# Optional: Static/Media (customize as needed)
AWS_STATIC_LOCATION=static
AWS_MEDIA_LOCATION=media
