files:
  "/etc/systemd/system/sqs-worker.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=SQS Worker Service
      After=network.target

      [Service]
      Type=simple
      ExecStart=/var/app/venv/staging-LQM1lest/bin/python /var/app/current/sqs_worker/sqs_worker.py
      WorkingDirectory=/var/app/current/sqs_worker
      StandardOutput=append:/var/app/current/sqs_worker/worker.log
      StandardError=append:/var/app/current/sqs_worker/worker.log
      Restart=always
      User=ec2-user

      [Install]
      WantedBy=multi-user.target

commands:
  01_set_permissions:
    command: |
      chown -R ec2-user:ec2-user /var/app/current/sqs_worker
      chmod -R 755 /var/app/current/sqs_worker
  02_reload_systemd:
    command: systemctl daemon-reload
  03_enable_service:
    command: systemctl enable sqs-worker
  04_start_service:
    command: systemctl start sqs-worker